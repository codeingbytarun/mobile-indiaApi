# MobiMarket Backend Environment Variables
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Provide your Atlas or local connection string here)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/mobimarket?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mobimarket

# Base URL for static file serving and QR codes
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# JWT Authentication Secrets
JWT_SECRET=mobimarket_super_secret_jwt_access_token_key_2026
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=mobimarket_super_secret_jwt_refresh_token_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (Optional - local fallback storage in /uploads is automatically used if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Free Email OTP Configuration (Use your Gmail & Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="MobiMarket" <no-reply@mobimarket.in>
